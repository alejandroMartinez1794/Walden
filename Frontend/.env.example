# Frontend environment variables example
# Copy this file to `.env` in the Frontend/ folder and edit values for your environment.

# Backend API base URL used by the frontend (used in src/config.js as VITE_BACKEND_URL)
# Keep the /api/v1 suffix so the frontend can call endpoints like ${BASE_URL}/auth/login
VITE_BACKEND_URL=http://localhost:8000/api/v1

# Production example:
# VITE_BACKEND_URL=https://api.basileia.app/api/v1

# Public site URL used for canonical tags, structured data and sitemap/robots generation.
# Keep it in https and without trailing slash.
VITE_PUBLIC_SITE_URL=https://basileia.tech

# hCaptcha site key (anti-bots)
# Development (use test key or get free key from hcaptcha.com)
VITE_HCAPTCHA_SITE_KEY=10000000-ffff-ffff-ffff-000000000001

# Production:
# VITE_HCAPTCHA_SITE_KEY=your_production_site_key

# ===== EXTERNAL LIBRARY CDN CONFIGURATION (Option C: Corporate CDN) =====
# To use external CDN for large libraries (Recharts, FullCalendar), provide your CDN URLs below.
# If empty or undefined, defaults to public CDN (unpkg.com).
# Recommended: host the UMD files on your corporate CDN for security and offline support.

VITE_CDN_RECHARTS_URL=https://your-cdn.com/libs/recharts/3.3.0/umd/Recharts.min.js
VITE_CDN_FULLCALENDAR_CORE_URL=https://your-cdn.com/libs/@fullcalendar/core/6.1.20/index.global.min.js
VITE_CDN_FULLCALENDAR_DAYGRID_URL=https://your-cdn.com/libs/@fullcalendar/daygrid/6.1.20/index.global.min.js
VITE_CDN_FULLCALENDAR_TIMEGRID_URL=https://your-cdn.com/libs/@fullcalendar/timegrid/6.1.20/index.global.min.js
VITE_CDN_FULLCALENDAR_INTERACTION_URL=https://your-cdn.com/libs/@fullcalendar/interaction/6.1.20/index.global.min.js
VITE_CDN_FULLCALENDAR_REACT_URL=https://your-cdn.com/libs/@fullcalendar/react/6.1.20/index.global.min.js
VITE_CDN_FULLCALENDAR_LOCALE_ES_URL=https://your-cdn.com/libs/@fullcalendar/core/6.1.20/locales/es.global.min.js

# Optional: enable fallback to public CDN if corporate CDN URLs fail (default: true)
VITE_CDN_FALLBACK=true

# After editing .env, restart the Vite dev server (npm run dev) to pick up changes.
